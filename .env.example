# Copy to `.env` and fill your real token (DO NOT COMMIT `.env`)
PUSHPLUS_TOKEN=your_pushplus_token_here

# Optional: choose strategy
# - ma250_drawdown (default)
# - ma200_drawdown
# - ma150_drawdown
# - discount_dca
# - market_breadth_dca
# - plain_dca
# - etf_dca_dip_buy
STRATEGY=ma250_drawdown

# Optional: for single-symbol strategies
SYMBOL=QQQ
